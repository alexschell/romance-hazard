# Personal data - exclude by default
# Use `data/raw/*` (not `data/raw/`) so file-level exceptions work below
data/raw/*
# Exception: explicitly created prototype data is tracked
!data/raw/relationships.csv

# R environment library (large, platform-specific)
renv/library/
renv/python/
renv/staging/

# Generated outputs
output/figures/

# R session artifacts
.Rhistory
.RData
.Ruserdata
*.Rproj.user/

# OS
.DS_Store
Thumbs.db
